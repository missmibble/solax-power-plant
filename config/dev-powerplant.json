{
  "name": "powerplant",
  "deployment": {
    "lambdaAlias": "dev",
    "retainVersions": 3
  },
  "env": {
    "account": "TODO_AWS_ACCOUNT_ID",
    "region": "ap-southeast-2"
  },
  "tags": {
    "Environment": "dev",
    "Project": "PowerPlant",
    "Owner": "TODO_OWNER",
    "ManagedBy": "CDK"
  },
  "dynamodb": {
    "energyReadingsTable": {
      "tableName": "POWERPLANT-ENERGY-READINGS",
      "cfResource": "PowerPlantEnergyReadingsTable",
      "description": "Time-series store of SolaX Cloud device realtime_data readings, polled every 5 minutes",
      "partitionKey": { "name": "DeviceSn", "type": "string" },
      "sortKey": { "name": "Timestamp", "type": "number" },
      "indexRequired": false,
      "streamEnabled": true,
      "streamViewType": "NEW_IMAGE"
    }
  },
  "s3": {
    "website": {
      "bucketName": "powerplant-dashboard-000000000000",
      "cfResource": "PowerPlantDashboardBucket",
      "description": "Static assets for the web dashboard (S3 + CloudFront is a later build phase)"
    }
  },
  "dashboard": {
    "domainName": "TODO_DASHBOARD_DOMAIN_NAME",
    "certificateArn": "TODO_DASHBOARD_CERTIFICATE_ARN"
  },
  "cognito": {
    "userPoolName": "powerplant-dashboard-users",
    "cfResource": "PowerPlantUserPool"
  },
  "sns": {
    "alertsTopic": {
      "topicName": "powerplant-alerts",
      "cfResource": "PowerPlantAlertsTopic",
      "description": "Inverter/battery fault and anomaly notifications"
    },
    "reportsTopic": {
      "topicName": "powerplant-reports",
      "cfResource": "PowerPlantReportsTopic",
      "description": "Nightly usage assessment and battery configuration recommendation report"
    }
  },
  "solax": {
    "baseUrl": "https://openapi-eu.solaxcloud.com",
    "businessType": 1,
    "deviceType": 1,
    "inverterSn": "TODO_INVERTER_SN",
    "batterySn": "TODO_BATTERY_SN"
  },
  "location": {
    "lat": 0,
    "lon": 0,
    "timezone": "Australia/Sydney"
  },
  "tariff": {
    "currency": "AUD",
    "importRates": [
      { "label": "night-ev-charge", "startTime": "00:00", "endTime": "06:00", "rate": 0.08 },
      { "label": "shoulder-morning", "startTime": "06:00", "endTime": "09:00", "rate": 0.32384 },
      { "label": "offpeak-midday", "startTime": "09:00", "endTime": "16:00", "rate": 0.20141 },
      { "label": "peak-evening", "startTime": "16:00", "endTime": "21:00", "rate": 0.41756 },
      { "label": "shoulder-night", "startTime": "21:00", "endTime": "24:00", "rate": 0.32384 }
    ],
    "feedInRate": 0.02
  },
  "bedrock": {
    "modelId": "TODO_BEDROCK_MODEL_ID",
    "historyLookbackDays": 14
  },
  "weather": {
    "provider": "openweathermap"
  },
  "batteryControl": {
    "dryRun": true,
    "minSoc": 10,
    "chargeFromGridEnable": 1,
    "chargeUpperSocSunny": 40,
    "chargeUpperSocOvercast": 100,
    "disabledChargeUpperSoc": 100,
    "chargeStartTimePeriod1": "00:00",
    "chargeEndTimePeriod1": "06:00",
    "chargeStartTimePeriod2": "00:00",
    "chargeEndTimePeriod2": "00:00",
    "dischargeStartTimePeriod1": "00:00",
    "dischargeEndTimePeriod1": "23:59",
    "dischargeStartTimePeriod2": "00:00",
    "dischargeEndTimePeriod2": "00:00",
    "enableTimePeriod2": 0
  },
  "gridDischarge": {
    "dryRun": true,
    "enabled": true,
    "windowStartTime": "17:00",
    "windowEndTime": "21:00",
    "checkTime": "19:00",
    "peakFeedInRate": 0.27,
    "safetyMarginPercent": 10,
    "maxDischargePowerW": 3000,
    "minSurplusPercent": 5,
    "historyLookbackDays": 14,
    "minHistoryDaysRequired": 3,
    "fallbackReservePercent": 26,
    "assumedUsableCapacityKwh": 10
  },
  "settingsOptimizer": {
    "enabled": true,
    "autoApply": false,
    "lookbackDays": 7,
    "minSampleSize": 3,
    "maxAdjustmentPercent": 15
  },
  "ssm": {
    "solaxClientId": {
      "parameterName": "/powerplant/solax/client-id",
      "cfResource": "PowerPlantSolaxClientIdParam",
      "description": "SolaX Cloud OAuth2 Client ID (developer.solaxcloud.com)"
    },
    "solaxClientSecret": {
      "parameterName": "/powerplant/solax/client-secret",
      "cfResource": "PowerPlantSolaxClientSecretParam",
      "description": "SolaX Cloud OAuth2 Client Secret (developer.solaxcloud.com)"
    },
    "weatherApiKey": {
      "parameterName": "/powerplant/weather/api-key",
      "cfResource": "PowerPlantWeatherApiKeyParam",
      "description": "OpenWeatherMap API key"
    }
  },
  "lambda": {
    "pollerFunction": {
      "functionName": "PollerFunction",
      "cfResource": "PowerPlantPollerFunction",
      "description": "Polls SolaX Cloud device realtime_data endpoint every 5 minutes and writes a reading to DynamoDB",
      "assetPath": "lambda/PollerFunction",
      "timer": 30,
      "schedule": "rate(5 minutes)"
    },
    "dashboardApiFunction": {
      "functionName": "DashboardApiFunction",
      "cfResource": "PowerPlantDashboardApiFunction",
      "description": "Aggregates DynamoDB readings into daily/weekly rollups for the dashboard",
      "assetPath": "lambda/DashboardApiFunction",
      "timer": 30
    },
    "alertFunction": {
      "functionName": "AlertFunction",
      "cfResource": "PowerPlantAlertFunction",
      "description": "Watches new readings for inverter/battery faults and unusually high daytime import; publishes to SNS",
      "assetPath": "lambda/AlertFunction",
      "timer": 30
    },
    "reportFunction": {
      "functionName": "ReportFunction",
      "cfResource": "PowerPlantReportFunction",
      "description": "Nightly assessment of stored usage data; recommends battery configuration optimizations and publishes a report",
      "assetPath": "lambda/ReportFunction",
      "timer": 60,
      "schedule": "cron(0 16 * * ? *)",
      "refreshSchedule": "cron(0 0,4,8,12,16,20 * * ? *)"
    },
    "batteryControlFunction": {
      "functionName": "BatteryControlFunction",
      "cfResource": "PowerPlantBatteryControlFunction",
      "description": "Checks tomorrow's weather forecast and adjusts the inverter's grid-charge target (chargeUpperSoc) accordingly; dry-run by default",
      "assetPath": "lambda/BatteryControlFunction",
      "timer": 30,
      "schedule": "cron(30 11 * * ? *)"
    },
    "gridDischargeFunction": {
      "functionName": "GridDischargeFunction",
      "cfResource": "PowerPlantGridDischargeFunction",
      "description": "Discharges surplus battery capacity to the grid during the premium 5-9pm feed-in window, then hands control back to Self Use; dry-run by default",
      "assetPath": "lambda/GridDischargeFunction",
      "timer": 30,
      "startSchedule": "cron(0 7 * * ? *)",
      "checkSchedule": "cron(0 9 * * ? *)",
      "exitSchedule": "cron(0 11 * * ? *)"
    },
    "settingsOptimizerFunction": {
      "functionName": "SettingsOptimizerFunction",
      "cfResource": "PowerPlantSettingsOptimizerFunction",
      "description": "Weekly AI assessment comparing hardcoded battery-charge and grid-discharge defaults against real usage; recommends (and optionally auto-applies) adjustments",
      "assetPath": "lambda/SettingsOptimizerFunction",
      "timer": 60,
      "schedule": "cron(0 12 ? * SUN *)"
    }
  },
  "api": {
    "restApiName": "PowerPlant Dashboard API",
    "cfResource": "PowerPlantRestApi",
    "description": "REST API serving dashboard rollups",
    "stageName": "dev",
    "apiKeyRequired": true,
    "apiKeyValue": "TODO_API_KEY_VALUE_PLACEHOLDER",
    "corsAllowOrigins": ["*"]
  }
}
